{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "observability": {
      "type": "object",
      "properties": {
        "openTelemetry": {
          "type": "object",
          "required": ["enabled", "serviceName", "serviceNamespace", "deploymentEnvironment", "tracesSampler", "tracesSamplerArg", "secretRef"],
          "properties": {
            "enabled": { "type": "boolean" },
            "serviceName": { "type": "string", "minLength": 1 },
            "serviceNamespace": { "type": "string", "minLength": 1 },
            "deploymentEnvironment": { "type": "string" },
            "tracesSampler": { "type": "string", "minLength": 1 },
            "tracesSamplerArg": { "type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$" },
            "secretRef": {
              "type": "object",
              "required": ["name", "endpointKey", "headersKey"],
              "properties": {
                "name": { "type": "string" },
                "endpointKey": { "type": "string", "minLength": 1 },
                "headersKey": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "controlPlaneService": {
      "type": "object",
      "required": ["enabled", "create", "name", "port", "retainOnDelete"],
      "properties": {
        "enabled": { "type": "boolean" },
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "retainOnDelete": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "selector": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "kubernetesSession": {
      "type": "object",
      "required": ["enabled", "pvc", "otelCollector"],
      "properties": {
        "enabled": { "const": true },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "rbac": {
          "type": "object",
          "required": ["create"],
          "properties": { "create": { "type": "boolean" } }
        },
        "pvc": {
          "type": "object",
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "otelCollector": {
          "type": "object",
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "scheduleWorker": {
      "type": "object",
      "required": ["enabled", "leaderElection"],
      "properties": {
        "enabled": { "type": "boolean" },
        "leaderElection": { "$ref": "#/definitions/leaderElection" }
      }
    },
    "slackbotCleanupWorker": {
      "type": "object",
      "required": ["enabled", "leaderElection"],
      "properties": {
        "enabled": { "type": "boolean" },
        "leaderElection": { "$ref": "#/definitions/leaderElection" }
      }
    },
    "stockInventoryWorker": {
      "type": "object",
      "required": ["enabled", "leaderElection"],
      "properties": {
        "enabled": { "type": "boolean" },
        "leaderElection": { "$ref": "#/definitions/leaderElection" }
      }
    },
    "redis": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "const": "standalone" }
      }
    },
    "externalRedis": {
      "type": "object",
      "properties": {
        "addr": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretPasswordKey": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "replicaCount": { "minimum": 2 } },
        "required": ["replicaCount"]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "redis": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            }
          },
          {
            "properties": {
              "externalRedis": {
                "properties": { "addr": { "minLength": 1 } },
                "required": ["addr"]
              }
            }
          }
        ]
      }
    }
  ],
  "definitions": {
    "leaderElection": {
      "type": "object",
      "required": ["leaseDuration", "renewDeadline", "retryPeriod"],
      "properties": {
        "leaseDuration": { "type": "string", "minLength": 1 },
        "renewDeadline": { "type": "string", "minLength": 1 },
        "retryPeriod": { "type": "string", "minLength": 1 }
      }
    }
  }
}
