{
  "auth": {
    "enabled": true,
    "admin_key": "set-via-AGENTAPI_AUTH_ADMIN_KEY-preferred",
    "github": {
      "enabled": true,
      "base_url": "https://api.github.com",
      "token_header": "Authorization",
      "user_mapping": {
        "default_role": "guest",
        "default_permissions": ["read"],
        "team_role_mapping": {
          "acme-corp/infrastructure": {
            "role": "admin",
            "permissions": ["*"]
          },
          "acme-corp/senior-engineers": {
            "role": "senior_dev",
            "permissions": ["read", "write", "execute", "debug", "deploy"]
          },
          "acme-corp/engineers": {
            "role": "developer",
            "permissions": ["read", "write", "execute"]
          },
          "acme-corp/interns": {
            "role": "trainee",
            "permissions": ["read"]
          }
        }
      }
    }
  }
}