{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentapi-ui",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "SUBDOMAIN_ROUTES_DB",
      "database_name": "ccplant-production-ui-routes",
      "database_id": "ac2fd39e-71fa-4147-aa7b-58799c3bee62",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "SUBDOMAIN_ROUTES_DB",
          "database_name": "ccplant-dev-ui-routes",
          "database_id": "2c30b1b1-0f8a-4f20-9b09-b2bc4713f556",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
