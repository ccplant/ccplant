{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "resources": { "$ref": "#/definitions/resourceRequirements" },
    "hostname": { "type": "string", "minLength": 1 },
    "cookieEncryptionSecret": {
      "type": "object",
      "required": ["enabled", "secretName", "secretKey"],
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string", "minLength": 1 },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "publicUrl": { "type": "string" },
        "proxyUrl": { "type": "string" }
      }
    }
  },
  "definitions": {
    "resourceQuantity": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "number", "minimum": 0 }
      ]
    },
    "resourceRequirements": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "$ref": "#/definitions/resourceQuantity" } },
        "limits": { "type": "object", "additionalProperties": { "$ref": "#/definitions/resourceQuantity" } }
      }
    }
  }
}
