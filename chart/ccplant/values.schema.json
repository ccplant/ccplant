{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "required": ["hostname", "apiHostname", "ingress"],
      "additionalProperties": true,
      "properties": {
        "hostname": { "type": "string", "minLength": 1 },
        "apiHostname": { "type": "string", "minLength": 1 },
        "ingress": {
          "type": "object",
          "required": ["className", "tls"],
          "properties": {
            "className": { "type": "string" },
            "tls": {
              "type": "object",
              "required": ["enabled"],
              "properties": { "enabled": { "type": "boolean" } }
            }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "cloudRun": {
      "type": "object",
      "required": ["enabled", "service", "scaling", "image", "container", "env", "secrets"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "service": {
          "type": "object",
          "required": ["name", "project", "region", "serviceAccount"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "project": { "type": "string" },
            "region": { "type": "string" },
            "serviceAccount": { "type": "string" }
          }
        },
        "ingress": { "type": "string", "enum": ["all", "internal", "internal-and-cloud-load-balancing"] },
        "scaling": {
          "type": "object",
          "required": ["minInstances", "maxInstances"],
          "additionalProperties": false,
          "properties": {
            "minInstances": { "type": "integer", "minimum": 0 },
            "maxInstances": { "type": "integer", "minimum": 1 }
          }
        },
        "startupCpuBoost": { "type": "boolean" },
        "containerConcurrency": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "digest"],
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "digest": { "type": "string" }
          }
        },
        "container": {
          "type": "object",
          "required": ["name", "command", "args", "port", "resources"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "args": { "type": "array", "items": { "type": "string" } },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "resources": {
              "type": "object",
              "required": ["cpu", "memory"],
              "additionalProperties": false,
              "properties": {
                "cpu": { "type": "string", "minLength": 1 },
                "memory": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["name", "version"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": ["string", "integer"] }
            }
          }
        }
      }
    }
  }
}
