{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "image", "parent", "runner", "internalApi", "sessionPersistence", "session"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "parent": {
      "type": "object",
      "required": ["url", "connectionTokenSecretRef", "hmacSecretRef"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "connectionTokenSecretRef": {"$ref": "#/$defs/namedSecretRef"},
        "hmacSecretRef": {"$ref": "#/$defs/namedSecretRef"}
      }
    },
    "runner": {
      "type": "object",
      "required": ["managerId", "pool"],
      "properties": {
        "managerId": {"type": "string", "minLength": 1},
        "pool": {"type": "string", "minLength": 1}
      }
    },
    "internalApi": {
      "type": "object",
      "required": ["tokenSecretRef"],
      "properties": {"tokenSecretRef": {"$ref": "#/$defs/namedSecretRef"}}
    },
    "sessionPersistence": {
      "type": "object",
      "required": ["backend", "suspendAfter", "s3"],
      "properties": {
        "backend": {"enum": ["", "volume", "s3"]},
        "suspendAfter": {"type": "string", "minLength": 1},
        "s3": {
          "type": "object",
          "properties": {
            "bucket": {"type": "string"},
            "region": {"type": "string"},
            "prefix": {"type": "string"},
            "endpoint": {"type": "string"},
            "accessKeyIdSecretRef": {"$ref": "#/$defs/optionalNamedSecretRef"},
            "secretAccessKeySecretRef": {"$ref": "#/$defs/optionalNamedSecretRef"}
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": ["provisioner"],
      "properties": {
        "image": {"type": "string"},
        "cliImage": {"type": "string"},
        "isolation": {
          "type": "object",
          "required": ["disableServiceLinks", "disableServiceAccountToken", "blockKubernetesAPI", "egressMode"],
          "properties": {
            "disableServiceLinks": {"type": "boolean"},
            "disableServiceAccountToken": {"type": "boolean"},
            "blockKubernetesAPI": {"type": "boolean"},
            "egressMode": {"type": "string", "enum": ["", "public-only"]}
          }
        },
        "provisioner": {
          "type": "object",
          "required": ["tokenSecretRef"],
          "properties": {"tokenSecretRef": {"$ref": "#/$defs/namedSecretRef"}}
        }
      }
    }
  },
  "$defs": {
    "namedSecretRef": {
      "type": "object",
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "optionalNamedSecretRef": {
      "type": "object",
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      }
    }
  }
}
